# Frontend Environment Configuration
# ==================================================
# API Base URL:
# - In local/LAN development, Leave as http://localhost:5000/api
#   The client dynamically replaces localhost with your machine's active LAN IP
#   when another device (phone, laptop) accesses the app.
# - In production, set to your domain API URL: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Development Authentication Bypass (set to false for standard JWT auth)
VITE_DEV_BYPASS_AUTH=false
