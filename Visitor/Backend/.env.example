PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=visitor_db

JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# Temporary credentials validity window (hours) before first-login password change
TEMP_PASSWORD_EXPIRATION_HOURS=24

UPLOAD_DIR=uploads

# Real Email Notification Configuration (Gmail / Custom SMTP)
EMAIL_ENABLED=true
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Visitor Management System <your_email@gmail.com>"

# Real SMS Notification Configuration (Twilio / Gateway)
SMS_ENABLED=true
SMS_PROVIDER=twilio
SMS_SENDER_ID=VMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+251921109998
